    "firebase-functions": "^7.1.1",
    "genkit": "^1.30.1",
    "googleapis": "^171.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
