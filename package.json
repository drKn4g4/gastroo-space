{
  "name": "gastroo-space",
  "version": "0.1.12",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 5202",
    "dev:start": "bash scripts/start-dev.sh",
    "dev:start:stage": "FEATURE_FLAG_PROFILE=stage bash scripts/start-dev.sh",
    "dev:start:prod": "FEATURE_FLAG_PROFILE=prod bash scripts/start-dev.sh",
    "dev:start:clean": "START_DEV_KILL_EMULATORS=true START_DEV_KILL_NEXT=true START_DEV_RESET_EMULATOR_DATA=true bash scripts/start-dev.sh",
    "dev:flags": "bash scripts/print-feature-flags.sh",
    "flags:validate": "bash scripts/validate-feature-flags.sh",
    "flags:validate:strict": "FEATURE_FLAGS_STRICT=true bash scripts/validate-feature-flags.sh",
    "dev:full": "npm run dev:start",
    "dev:emulators": "NEXT_PUBLIC_USE_EMULATORS=true firebase emulators:start --import=./.firebase/emulator-data --export-on-exit=./.firebase/emulator-data & sleep 4 && NEXT_PUBLIC_USE_EMULATORS=true next dev --turbopack --port 5202",
    "emulators": "firebase emulators:start --import=./.firebase/emulator-data --export-on-exit=./.firebase/emulator-data",
    "emulators:clean": "firebase emulators:start",
    "emulators:compact": "bash scripts/compact-emulator-space.sh",
    "seed": "npx tsx scripts/seed.ts",
    "seed:core": "SEED_PROFILE=core npx tsx scripts/seed.ts",
    "seed:demo": "SEED_PROFILE=demo npx tsx scripts/seed.ts",
    "seed:integration": "SEED_PROFILE=integration npx tsx scripts/seed.ts",
    "seed:all": "SEED_PROFILE=all npx tsx scripts/seed.ts",
    "seed:unified": "SEED_PROFILE=all npx tsx scripts/seed.ts",
    "build": "next build --webpack",
    "start": "next start --port 5202",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:px": "node scripts/check-no-px.mjs",
    "deploy:firebase": "bash scripts/deploy-firebase.sh",
    "deploy:local": "bash scripts/deploy-local.sh",
    "deploy:env:check": "bash scripts/validate-deploy-env.sh --strict",
    "deploy:smoke": "bash scripts/smoke-postdeploy.sh",
    "release:deploy": "node scripts/bump-version-and-changelog.mjs",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:seed:contracts": "npx vitest run src/app/api/seed/_lib/__tests__/seed-format.test.ts src/app/api/seed/__tests__/seed-routes.integration.test.ts",
    "test:e2e": "playwright test tests/e2e --config=playwright.config.ts",
    "test:e2e:imported": "PLAYWRIGHT_USE_IMPORTED_DATA=true playwright test --config=playwright.config.ts",
    "test:e2e:seeded": "PLAYWRIGHT_USE_IMPORTED_DATA=false playwright test --config=playwright.config.ts",
    "test:e2e:pwa-matrix": "playwright test tests/e2e/pwa-responsive-matrix.spec.ts --config=playwright.config.ts",
    "test:rules": "npx vitest run src/lib/firebase/__tests__/firestore.rules.test.ts",
    "test:api": "bash scripts/test-api.sh",
    "test:ui": "playwright test tests/ui-ux.spec.ts --reporter=html",
    "perf:smoke": "docker run --rm -i -e BASE_URL=${BASE_URL:-http://host.docker.internal:5202} -v \"$PWD/tests/perf\":/scripts grafana/k6 run /scripts/smoke.js",
    "container:smoke": "docker build -t gastroo-space:ci . && docker run --rm -d -p 5202:5202 --name gastroo-space-ci gastroo-space:ci && sleep 10 && curl -fsS http://127.0.0.1:5202 >/dev/null && docker rm -f gastroo-space-ci",
    "finito": "bash scripts/finito.sh"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@firebasegen/default-connector": "file:dataconnect-generated/js/default-connector",
    "@formatjs/intl-localematcher": "^0.8.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@stripe/stripe-js": "^8.11.0",
    "@vis.gl/react-google-maps": "^1.7.1",
    "@vitejs/plugin-react": "^6.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "gpt3-tokenizer": "^1.1.5",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "negotiator": "^1.0.0",
    "next": "^16.2.1",
    "openai": "^6.29.0",
    "qrcode.react": "^4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^16.5.8",
    "stripe": "^20.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/ui": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
