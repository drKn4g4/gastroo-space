# Example production env file (safe to commit).
# Copy to `.env.production` and fill values.

NODE_ENV=production
NEXT_PUBLIC_USE_EMULATORS=false

# ── Firebase (public client config) ──────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_RESTAURANT_NAME=gastroo.space

# ── Seed Admin (protect /api/seed/*) ─────────────────────────────────────────
SEED_ADMIN_KEY=change-me
SEED_REQUIRE_ADMIN_CLAIM=false
SEED_ADMIN_CLAIM=seedAdmin

# ── Seeds on Google Drive (server-side) ──────────────────────────────────────
GDRIVE_SEED_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Client integrations (optional) ───────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WORKSPACE_CLIENT_ID=   # jeśli puste, fallback na NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID

# ── Functions OAuth (server-side) ────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# ── Google Calendar OAuth (server-side) ──────────────────────────────────────
# Jeśli puste, funkcje używają fallbacku z GOOGLE_DRIVE_*
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://your-domain.web.app/api/calendar/callback

# ── Google Workspace OAuth (server-side: Sheets, Docs, Tasks) ────────────────
# Jeśli puste, funkcje używają fallbacku z GOOGLE_DRIVE_*
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=https://your-domain.web.app/api/workspace/callback

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_APPLICATION_FEE_PERCENT=1.5

# ── Stripe Feature Flags ──────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_STRIPE_PAYMENTS=false
NEXT_PUBLIC_FEATURE_STRIPE_BILLING=false

